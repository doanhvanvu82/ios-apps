{
  "manifest_version": 3,
  "default_locale": "vi",
  "name": "__MSG_extension_name__",
  "description": "__MSG_extension_description__",
  "version": "1.0",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "background": {
    "scripts": ["rules/validate.js", "background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/main_world.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["rules/validate.js", "content/candidates.js", "content/content.js", "content/privacy.js", "content/picker.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/main_world.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "images/toolbar-16.png",
      "19": "images/toolbar-19.png",
      "32": "images/toolbar-32.png",
      "38": "images/toolbar-38.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_custom",
        "enabled": true,
        "path": "rules/ad_domains.json"
      },
      {
        "id": "ads",
        "enabled": true,
        "path": "filters/ads_network.json"
      },
      {
        "id": "tracking",
        "enabled": true,
        "path": "filters/tracking_network.json"
      }
    ]
  },
  "permissions": ["storage", "tabs", "activeTab", "nativeMessaging", "declarativeNetRequest", "scripting"],
  "host_permissions": ["<all_urls>"]
}
