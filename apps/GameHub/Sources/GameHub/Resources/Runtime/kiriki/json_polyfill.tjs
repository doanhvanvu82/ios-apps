// GameHub: thay the json.dll (runtime web khong co plugin nay). Game goi
// Scripts.evalJSONStorage(file) de doc file cau hinh JSON "noi long" (comment,
// dau phay thua, so hex $ffffff) -> doi sang cu phap dictionary/array cua TJS
// roi Scripts.eval. KiriKiriPatch.swift dua file nay vao patch.xp3 ao, chay
// truoc PluginLoader.tjs goc cua game.
if (typeof global.Scripts.evalJSON == "undefined") {
	global.Scripts.evalJSON = function(text) {
		var out = [];
		var n = text.length;
		var i = 0;
		var last = -1;
		while (i < n) {
			var c = text[i];
			if (c == '"') {
				var j = i + 1;
				while (j < n && text[j] != '"') {
					if (text[j] == "\\") j++;
					j++;
				}
				out.add(text.substring(i, j - i + 1));
				last = out.count - 1;
				i = j + 1;
				continue;
			}
			if (c == "/" && i + 1 < n && text[i + 1] == "*") {
				var e = text.indexOf("*/", i + 2);
				i = e < 0 ? n : e + 2;
				continue;
			}
			if (c == "/" && i + 1 < n && text[i + 1] == "/") {
				var e = text.indexOf("\n", i + 2);
				i = e < 0 ? n : e + 1;
				continue;
			}
			if (c == "}" || c == "]") {
				if (last >= 0 && out[last] == ",") out[last] = "";
				out.add("]");
				last = out.count - 1;
			} else if (c == "{") {
				out.add("%[");
				last = out.count - 1;
			} else if (c == ":") {
				out.add("=>");
				last = out.count - 1;
			} else if (c == "$") {
				// json.dll doc $ffffff la so hex; trong TJS $ la ma ky tu.
				out.add("0x");
				last = out.count - 1;
			} else {
				out.add(c);
				if (c != " " && c != "\t" && c != "\r" && c != "\n") last = out.count - 1;
			}
			i++;
		}
		return Scripts.eval(out.join(""));
	} incontextof null;
}

if (typeof global.Scripts.evalJSONStorage == "undefined") {
	global.Scripts.evalJSONStorage = function(storage) {
		if (Storages.getPlacedPath(storage) == "") return void;
		var lines = [].load(storage);
		return Scripts.evalJSON(lines.join("\n"));
	} incontextof null;
}
